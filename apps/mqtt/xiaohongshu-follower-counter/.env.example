# The bridge reads process environment variables, not this file automatically.
XHS_BRIDGE_TOKEN=replace-with-a-random-local-token
XHS_BRIDGE_PORT=17321

# One-release legacy fallback only. New installations discover these values
# from each TC002 configured in the Chrome extension. If used, MQTT_HOST and
# TC002_MQTT_TOPIC must both be set; uncomment only the values you need.
# MQTT_HOST=192.168.1.10
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TLS=false
# MQTT_ALLOW_SELF_SIGNED=false
# MQTT_CLIENT_ID=
# TC002_MQTT_TOPIC=ulanzi_abcd/custom/display
