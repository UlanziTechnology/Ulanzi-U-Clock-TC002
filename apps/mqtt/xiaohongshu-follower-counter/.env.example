# Copy these values into your terminal environment. The bridge does not read
# this file automatically. Replace every value marked "replace-with".
XHS_BRIDGE_TOKEN=replace-with-a-random-local-token
XHS_BRIDGE_PORT=17321
MQTT_HOST=replace-with-your-mqtt-host
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_ALLOW_SELF_SIGNED=false
MQTT_CLIENT_ID=
TC002_MQTT_TOPIC=replace-with-your-tc002-custom-app-topic
